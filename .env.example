# ---- Email digest (SMTP) ---------------------------------------------
# Set EMAIL_ENABLED=1 to send the daily digest via the script.
EMAIL_ENABLED=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=1
EMAIL_FROM=you@gmail.com
EMAIL_TO="you@gmail.com, friend@example.com"
EMAIL_SUBJECT_PREFIX="[Daily Betting Tips]"

# ---- ntfy.sh push notification (free phone push, recommended) --------
# Set NTFY_ENABLED=1 and a hard-to-guess topic to push the digest to phones.
NTFY_ENABLED=1
NTFY_TOPIC=DailyBettingTips-7f9k2Qz
NTFY_URL=https://ntfy.sh

# Assumed stake (€) for the "if all win" line in the digest
DIGEST_STAKE=1

# ---- (unused by the Flashscore scanner; kept for legacy API client) ----
API_FOOTBALL_KEY=